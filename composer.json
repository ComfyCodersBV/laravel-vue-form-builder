{
    "name": "tranquil-tools/laravel-vue-form-builder",
    "description": "A VueJS/Inertia renderer for tranquil-tools/laravel-form-builder",
    "keywords": [
        "ComfyCoders BV",
        "laravel",
        "laravel-vue-form-builder"
    ],
    "homepage": "https://github.com/comfycodersbv/laravel-vue-form-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "ComfyCoders BV",
            "email": "development@comfycoders.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "tranquil-tools/laravel-form-builder": "^1.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^9.0.0||^10.0.0||^11.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "TranquilTools\\VueFormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TranquilTools\\VueFormBuilder\\Tests\\": "tests/Php/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
